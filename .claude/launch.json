{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx expo start --web --port \"${PORT:-8082}\""
      ],
      "port": 8082,
      "autoPort": true
    },
    {
      "name": "web-export",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec npx --yes serve@14.2.4 dist --listen \"${PORT:-8083}\""
      ],
      "port": 8083,
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd docs/interactive && exec npx vite --port \"${PORT:-5180}\" --strictPort"
      ],
      "port": 5180,
      "autoPort": true
    }
  ]
}
