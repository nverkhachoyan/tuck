{
	"code_actions_on_format": {
		"source.fixAll": false,
		"source.organizeImports": false
	},
	"languages": {
		"JavaScript": {
			"language_servers": ["vtsls", "biome", "!eslint"],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.organizeImports.biome": true,
				"source.fixAll.biome": true
			}
		},
		"TypeScript": {
			"language_servers": ["vtsls", "biome", "!eslint"],
			"formatter": {
				"language_server": {
