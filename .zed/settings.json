{
	"disable_ai": true,
	"lsp": {
		"typescript-ls": {
			"settings": {
				"package_version": "7.0.2"
			}
		}
	},
	"code_actions_on_format": {
		"source.fixAll": true,
		"source.organizeImports": true
	},
	"languages": {
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"biome",
				"!typescript-language-server",
				"!eslint"
			],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.organizeImports.biome": true,
				"source.fixAll.biome": true
			}
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"biome",
				"!typescript-language-server",
				"!eslint"
			],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.organizeImports.biome": true,
				"source.fixAll.biome": true
			}
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"biome",
				"!typescript-language-server",
				"!eslint"
			],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.organizeImports.biome": true,
				"source.fixAll.biome": true
			}
		},
		"JSON": {
			"language_servers": ["json-language-server", "biome"],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true
			}
		},
		"JSONC": {
			"language_servers": ["json-language-server", "biome"],
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			},
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true
			}
		}
	}
}
