{
	"expo": {
		"scheme": "photo-editor",
		"userInterfaceStyle": "dark",
		"orientation": "portrait",
		"web": {
			"output": "static"
		},
		"plugins": [
			"expo-router",
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow access to photos.",
					"colors": {
						"cropToolbarColor": "#000000"
					},
					"dark": {
						"colors": {
							"cropToolbarColor": "#000000"
						}
					}
				}
			],
			[
				"expo-media-library",
				{
					"photosPermission": "Allow access to photos.",
					"savePhotosPermission": "Allow saving your edited photos.",
					"granularPermissions": ["photo"]
				}
			],
			"expo-sharing",
			"expo-asset",
			"expo-font"
		],
		"name": "photo-editor",
		"slug": "photo-editor"
	}
}
