{
	"expo": {
		"scheme": "photo-editor",
		"userInterfaceStyle": "dark",
		"backgroundColor": "#0A0A0B",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#141416"
			}
		},
		"web": {
			"output": "static",
			"favicon": "./assets/favicon.png",
			"backgroundColor": "#0A0A0B",
			"themeColor": "#0A0A0B",
			"barStyle": "black-translucent"
		},
		"plugins": [
			"expo-router",
			[
				"expo-image-picker",
				{
					"photosPermission": "Used to open the photos you choose for editing. They stay on your device.",
					"cameraPermission": false,
					"microphonePermission": false,
					"colors": {
						"cropToolbarColor": "#000000"
					},
					"dark": {
						"colors": {
							"cropToolbarColor": "#000000"
						}
					}
				}
			],
			[
				"expo-media-library",
				{
					"photosPermission": "Used to open the photos you choose for editing. They stay on your device.",
					"savePhotosPermission": "Used to save your edited photos to your library.",
					"granularPermissions": ["photo"]
				}
			],
			"expo-sharing",
			"expo-asset",
			"expo-font"
		],
		"name": "Tuck",
		"slug": "photo-editor"
	}
}
