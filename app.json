{
	"expo": {
		"scheme": "photo-editor",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#FFFFFF",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"ios": {
			"bundleIdentifier": "com.nverk.photoeditor"
		},
		"android": {
			"package": "com.nverk.photoeditor",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#FFFFFF"
			}
		},
		"web": {
			"output": "static",
			"favicon": "./assets/favicon.png",
			"backgroundColor": "#FFFFFF",
			"themeColor": "#FFFFFF",
			"barStyle": "default"
		},
		"plugins": [
			"expo-router",
			[
				"expo-image-picker",
				{
					"photosPermission": "Used to open the photos you choose for editing. They stay on your device.",
					"cameraPermission": false,
					"microphonePermission": false,
					"colors": {
						"cropToolbarColor": "#000000"
					},
					"dark": {
						"colors": {
							"cropToolbarColor": "#000000"
						}
					}
				}
			],
			[
				"expo-media-library",
				{
					"photosPermission": "Used to open the photos you choose for editing. They stay on your device.",
					"savePhotosPermission": "Used to save your edited photos to your library.",
					"granularPermissions": ["photo"]
				}
			],
			"expo-sharing",
			"expo-asset",
			"expo-font",
			"./modules/image-analysis/app.plugin.js",
			"./modules/share-target/app.plugin.js",
			"./plugins/withSceneLifecycle.js"
		],
		"name": "Tuck",
		"slug": "photo-editor"
	}
}
