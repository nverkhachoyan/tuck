{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/.claude"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["**/package.json", "**/package-lock.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/model/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**", "!./*"],
										"message": "model/ is plain TypeScript: it imports only other model files, and node: modules in tests. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/model/__tests__/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**", "!./*", "!../*", "!node:*", "!node:*/**"],
										"message": "model/ is plain TypeScript: it imports only other model files, and node: modules in tests. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["image-analysis", "@/**", "../**", "!@/lib/**"],
										"message": "lib/ holds plain helpers: it imports only other lib/ files. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/__tests__/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!../*",
											"!@/lib/**"
										],
										"message": "lib/ holds plain helpers: it imports only other lib/ files. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**"],
