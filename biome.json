{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/.claude"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["package.json", "package-lock.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/model/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**", "!./*", "!node:*", "!node:*/**"],
										"message": "model/ is plain TypeScript: it imports only other model files, and node: modules in tests. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/layers/**", "src/store/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "layers/ and store/ import only model/, lib/, ui/, and theme.ts (not each other), and their own folder with ./. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/editor/**",
				"src/import/**",
				"src/render/**",
				"src/projects/**",
				"src/stickers/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/layers/**",
											"!../layers/**",
											"!../../layers/**",
											"!../../../layers/**",
											"!@/store",
											"!@/store/**",
											"!../store",
											"!../store/**",
											"!../../store/**",
											"!../../../store/**",
											"!@/model/**",
											"!../model/**",
											"!../../model/**",
											"!../../../model/**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "Editor helpers and shared capability folders may import only lower-level modules or files in their own folder. Only detection/ imports image-analysis. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/editor/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"./*/**",
											"!@/layers/**",
											"!../../layers/**",
											"!@/store",
											"!@/store/**",
											"!../../store",
											"!../../store/**",
											"!@/model/**",
											"!../../model/**",
											"!@/detection/**",
											"!@/import/**",
											"!@/stickers/**",
											"!@/lib/**",
											"!../../lib/**",
											"!@/ui/**",
											"!../../ui/**",
											"!@/theme",
											"!../../theme",
											"!../../theme.ts"
										],
										"message": "Editor root helpers import only each other and shared lower-level modules. EditorScreen composes subfolders. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/editor/*/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!../*",
											"!../handles/*",
											"!@/detection/**",
											"!@/stickers/**",
											"!@/layers/**",
											"!../../../layers/**",
											"!@/store",
											"!@/store/**",
											"!../../../store",
											"!../../../store/**",
											"!@/model/**",
											"!../../../model/**",
											"!@/lib/**",
											"!../../../lib/**",
											"!@/ui/**",
											"!../../../ui/**",
											"!@/theme",
											"!../../../theme",
											"!../../../theme.ts"
										],
										"message": "Editor subfolders import only themselves, editor root helpers, handles/, stickers/, and shared lower-level modules. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/editor/EditorScreen.tsx"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"../**",
											"!@/screens/editor/**"
										],
										"message": "The editor may compose its own folder and shared capabilities, but may not import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/home/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"../**",
											"!@/screens/home/**"
										],
										"message": "Home may not import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/about/**",
				"src/screens/create/**",
				"src/screens/export/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"../**",
											"!../../model/**"
										],
										"message": "Screens may not import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["image-analysis", "@/**", "../**", "!@/lib/**"],
										"message": "lib/ holds plain helpers: it imports only other lib/ files. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**", "src/theme.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "ui/ and theme.ts never import app code, only each other and lib/. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/detection/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@/**", "../**", "!../model/**", "!../lib/**"],
										"message": "detection/ imports only its own files, the image-analysis bridge, and lower-level model/ and lib/ modules. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["image-analysis"],
										"message": "Only detection/ imports the image-analysis bridge. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
