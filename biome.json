{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/.claude"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["package.json", "package-lock.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/model/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**", "!./*", "!node:*", "!node:*/**"],
										"message": "model/ is plain TypeScript: it imports only other model files, and node: modules in tests. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["image-analysis", "@/**", "../**", "!@/lib/**"],
										"message": "lib/ holds plain helpers: it imports only other lib/ files. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**", "src/theme.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "ui/ and theme.ts import only each other and lib/, never app code. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/store/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**"
										],
										"message": "store/ imports only model/ and lib/. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/photos/**", "src/projects/**", "src/render/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**",
											"!@/store",
											"!@/store/**",
											"!../store",
											"!../store/**",
											"!@/ui/**",
											"!@/theme"
										],
										"message": "Shared capabilities (photos/, projects/, render/) import only store/, model/, lib/, ui/, and theme.ts: not each other, and no screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["image-analysis"],
										"message": "Only the editor's detection/ imports the image-analysis bridge. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/info/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/info/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/create/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/create/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/export/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/export/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/home/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/home/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/settings/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/settings/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/editor/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/editor/**"
										],
										"message": "The editor doesn't import routes or another screen, and only its detection/ imports image-analysis. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/editor/add/**",
				"src/screens/editor/adjust/**",
				"src/screens/editor/crop/**",
				"src/screens/editor/cutout/**",
				"src/screens/editor/draw/**",
				"src/screens/editor/panels/**",
				"src/screens/editor/redact/**",
				"src/screens/editor/text/**",
				"src/screens/editor/canvas/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/editor/**",
											"../add/**",
											"@/screens/editor/add/**",
											"../adjust/**",
											"@/screens/editor/adjust/**",
											"../crop/**",
											"@/screens/editor/crop/**",
											"../cutout/**",
											"@/screens/editor/cutout/**",
											"../draw/**",
											"@/screens/editor/draw/**",
											"../panels/**",
											"@/screens/editor/panels/**",
											"../redact/**",
											"@/screens/editor/redact/**",
											"../text/**",
											"@/screens/editor/text/**"
										],
										"message": "The editor's tools (add/, adjust/, crop/, cutout/, draw/, panels/, redact/, text/) don't import each other, and canvas/ imports none of them: what they share is at the editor root or in canvas/, controls/, handles/, detection/, or stickers/. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/editor/controls/**",
				"src/screens/editor/handles/**",
				"src/screens/editor/stickers/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"../**",
											"!../../../**"
										],
										"message": "The editor's building blocks (controls/, handles/, stickers/) import nothing else from the editor. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/editor/detection/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"../**",
											"!@/model/**",
											"!../../../model/**",
											"!@/lib/**",
											"!../../../lib/**"
										],
										"message": "detection/ imports only its own files, the image-analysis bridge, model/, and lib/. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
