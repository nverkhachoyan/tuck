{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/.claude"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["package.json", "package-lock.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/model/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**", "!./*", "!node:*", "!node:*/**"],
										"message": "model/ is plain TypeScript: it imports only other model files, and node: modules in tests. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/layers/**", "src/store/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"../**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "layers/ and store/ import only model/, lib/, ui/, and theme.ts (not each other), and their own folder with ./. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/editor/**",
				"src/import/**",
				"src/export/**",
				"src/projects/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"../**",
											"!@/layers/**",
											"!../layers/**",
											"!@/store",
											"!@/store/**",
											"!../store",
											"!../store/**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "editor/, import/, export/, and projects/ import only layers/, store/, model/, lib/, ui/, and theme.ts, and their own folder with ./. Not each other or routes: app/ wires them together. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/editor/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"../**",
											"./*/**",
											"!@/layers/**",
											"!../layers/**",
											"!@/store",
											"!@/store/**",
											"!../store",
											"!../store/**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "The editor/ root imports only its own files with ./, and layers/, store/, model/, lib/, ui/, and theme.ts. Not its subfolders: they import the root, not the other way around. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/editor/*/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"../**",
											"!../*",
											"!@/layers/**",
											"!../../layers/**",
											"!@/store",
											"!@/store/**",
											"!../../store",
											"!../../store/**",
											"!@/model/**",
											"!../../model/**",
											"!@/lib/**",
											"!../../lib/**",
											"!@/ui/**",
											"!../../ui/**",
											"!@/theme",
											"!../../theme",
											"!../../theme.ts"
										],
										"message": "An editor/ subfolder imports only its own files with ./, the editor/ root with ../, and layers/, store/, model/, lib/, ui/, and theme.ts. Not another subfolder: what two of them share lives at the editor/ root. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**", "src/lib/**", "src/theme.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"@/**",
											"../**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**",
											"!@/theme",
											"!../theme",
											"!../theme.ts"
										],
										"message": "ui/, lib/, and theme.ts never import app code, only each other. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
