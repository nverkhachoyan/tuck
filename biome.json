{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/.claude"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["package.json", "package-lock.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/model/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**", "!./*", "!node:*", "!node:*/**"],
										"message": "model/ is plain TypeScript: it imports only other model files, and node: modules in tests. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/lib/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["image-analysis", "@/**", "../**", "!@/lib/**"],
										"message": "lib/ holds plain helpers: it imports only other lib/ files. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**",
											"!../ui/**"
										],
										"message": "ui/ imports only itself and lib/, never app code. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/store/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**"
										],
										"message": "store/ imports only model/ and lib/. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/photos/**", "src/projects/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**"
										],
										"message": "photos/ and projects/ import only model/ and lib/: not each other, store/, ui/, render/, or any screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/render/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/**",
											"../**",
											"!@/model/**",
											"!../model/**",
											"!@/lib/**",
											"!../lib/**",
											"!@/ui/**"
										],
										"message": "render/ imports only model/, lib/, and ui/: no store, projects, photos, or screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["image-analysis"],
										"message": "Only the editor's find/ and cutout/ import the image-analysis bridge. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/info/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/info/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/create/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/create/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/export/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/export/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/home/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/home/**",
											"../**",
											"!../../model/**"
										],
										"message": "A screen doesn't import routes or another screen. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/screens/editor/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/editor/**",
											"../create/**",
											"../export/**",
											"../home/**",
											"../info/**",
											"../../create/**",
											"../../export/**",
											"../../home/**",
											"../../info/**"
										],
										"message": "The editor doesn't import routes or another screen, and only find/imageDetection.ts and cutout/subjectDetection.ts import image-analysis. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/editor/crop/**",
				"src/screens/editor/canvas/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/editor/**",
											"../adjust/**",
											"@/screens/editor/adjust/**",
											"../crop/**",
											"@/screens/editor/crop/**",
											"../cutout/**",
											"@/screens/editor/cutout/**",
											"../draw/**",
											"@/screens/editor/draw/**",
											"../find/**",
											"@/screens/editor/find/**",
											"../layers/**",
											"@/screens/editor/layers/**",
											"../redact/**",
											"@/screens/editor/redact/**",
											"../stickers/**",
											"@/screens/editor/stickers/**",
											"../text/**",
											"@/screens/editor/text/**"
										],
										"message": "canvas/ and crop/ don't import the editor's other tools. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/editor/adjust/**",
				"src/screens/editor/cutout/**",
				"src/screens/editor/draw/**",
				"src/screens/editor/find/**",
				"src/screens/editor/layers/**",
				"src/screens/editor/redact/**",
				"src/screens/editor/stickers/**",
				"src/screens/editor/text/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"!@/screens/editor/**",
											"../adjust/**",
											"@/screens/editor/adjust/**",
											"../canvas/**",
											"@/screens/editor/canvas/**",
											"../crop/**",
											"@/screens/editor/crop/**",
											"../cutout/**",
											"@/screens/editor/cutout/**",
											"../draw/**",
											"@/screens/editor/draw/**",
											"../find/**",
											"@/screens/editor/find/**",
											"../layers/**",
											"@/screens/editor/layers/**",
											"../redact/**",
											"@/screens/editor/redact/**",
											"../stickers/**",
											"@/screens/editor/stickers/**",
											"../text/**",
											"@/screens/editor/text/**"
										],
										"message": "The editor's tools (adjust/, cutout/, draw/, find/, layers/, redact/, stickers/, text/) don't import each other or canvas/: what they share is at the editor root or in controls/. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/editor/controls/**",
				"src/screens/editor/stickers/**"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"image-analysis",
											"@/app/**",
											"@/screens/**",
											"../**",
											"!../shortcuts",
											"!@/screens/editor/shortcuts",
											"!../../../**"
										],
										"message": "The editor's building blocks (controls/, stickers/) import nothing else from the editor. See AGENTS.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/screens/editor/find/imageDetection.ts",
				"src/screens/editor/cutout/subjectDetection.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}
