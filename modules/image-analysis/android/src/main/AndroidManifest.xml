<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application>
    <!-- ONNX Runtime starts an HTTP telemetry client at app launch from this
      provider, before any of the app's code can turn it off. -->
    <provider
      android:name="ai.onnxruntime.TelemetryInitializer"
      tools:node="remove" />
    <!-- ML Kit logs usage to Google's Clearcut through datatransport, which
      finds its upload backend here. Without it, events are dropped before
      they're stored or scheduled. -->
    <service
      android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
      tools:node="remove" />
  </application>
</manifest>
