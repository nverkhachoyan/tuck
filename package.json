{
  "name": "tuck",
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"modules/**/*.test.ts\"",
    "postinstall": "node scripts/copy-web-assets.mjs",
    "build:web": "expo export -p web && cp dist/+not-found.html dist/404.html && node scripts/write-service-worker.mjs && node scripts/check-csp.mjs",
    "deploy": "npm run build:web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/courier-prime": "^0.4.1",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/permanent-marker": "^0.4.0",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-media-library": "~58.0.13",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-system-ui": "~58.0.7",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-skia": "2.15.2",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.16"
  },
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^24.13.6",
    "@types/react-dom": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
