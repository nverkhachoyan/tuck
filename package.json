{
  "name": "tuck",
  "main": "index",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"modules/**/*.test.ts\"",
    "postinstall": "node scripts/copy-web-assets.mjs",
    "build:web": "expo export -p web && cp dist/+not-found.html dist/404.html && node scripts/write-service-worker.mjs && node scripts/check-csp.mjs",
    "deploy": "npm run build:web && npx eas-cli@latest deploy"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/courier-prime": "^0.4.1",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/permanent-marker": "^0.4.0",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "expo": "^57.0.1",
    "expo-asset": "~57.0.18",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.1",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.2",
    "expo-sharing": "~57.0.21",
    "expo-system-ui": "~57.0.4",
    "onnxruntime-web": "1.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "@types/react-dom": "~19.2.3",
    "typescript": "~6.0.3"
  }
}
