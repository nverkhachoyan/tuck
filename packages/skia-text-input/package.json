{
  "name": "@tuck/skia-text-input",
  "version": "0.0.0",
  "private": true,
  "description": "Edit text in place on a React Native Skia canvas.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./core": {
        "types": "./lib/core.d.ts",
        "default": "./lib/core.js"
      }
    }
  },
  "files": [
    "lib",
    "src",
    "!src/__tests__",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-gesture-handler": ">=3",
    "react-native-reanimated": ">=4",
    "react-native-skia": ">=2.15",
    "react-native-worklets": ">=0.13"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-skia": "2.15.2",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  }
}
