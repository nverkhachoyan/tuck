+// Clones that hold a remote function (see cloneNonWorkletFunction), directly
+// or inside. A remote function keeps the function it wraps alive from native
+// code, and that function's closure can reach the cloned value again (a
+// component's callback reaches its worklets through the React fiber). A
+// strong cache entry would close that loop through native memory, out of the
+// garbage collector's sight, so these clones are cached weakly.
+const holdsRemoteFunction = new WeakSet<object>();
+// Whether the value being cloned holds a remote function so far.
+let sawRemoteFunction = false;
+
+function trackRemoteFunctions<TClone extends object>(
+  build: () => TClone
+): [TClone, boolean] {
+  const outer = sawRemoteFunction;
+  sawRemoteFunction = false;
+  let holdsRemote = false;
+  try {
+    const clone = build();
+    holdsRemote = sawRemoteFunction;
+    if (holdsRemote) {
+      holdsRemoteFunction.add(clone);
+    }
+    return [clone, holdsRemote];
+  } finally {
+    sawRemoteFunction = outer || holdsRemote;
+  }
+}
+
+function cacheClone(value: object, clone: object, holdsRemote: boolean) {
+  serializableMappingCache.set(
+    value,
+    (holdsRemote && globalThis.WeakRef
+      ? new WeakRef(clone)
+      : clone) as SerializableRef
+  );
+}
