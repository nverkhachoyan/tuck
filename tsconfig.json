{
	"compilerOptions": {
		// Tests run on Node's built-in TypeScript support, which needs explicit
		// `.ts` extensions on relative imports.
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"],
			"image-analysis": ["./modules/image-analysis"]
		}
	},
	"extends": "expo/tsconfig.base"
}
