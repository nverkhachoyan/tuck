{
	"compilerOptions": {
		// Tests run on Node's built-in TypeScript support, which needs explicit
		// `.ts` extensions on relative imports.
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"],
			"image-analysis": ["./modules/image-analysis"]
		}
	},
	"extends": "expo/tsconfig.base",
	// Expo's base excludes; `docs/interactive` is its own project with its own
	// tsconfig.
	"exclude": [
		"node_modules",
		"babel.config.js",
		"metro.config.js",
		"jest.config.js",
		"android",
		"ios",
		"docs/interactive"
	]
}
