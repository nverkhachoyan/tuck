{
	"cleanUrls": true,
	"headers": [
		{
			"source": "/(_expo/static|assets)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/canvaskit.wasm",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=604800"
				}
			]
		},
		{
			"source": "/(mediapipe|tesseract)/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=86400, stale-while-revalidate=604800"
				}
			]
		}
	],
	"redirects": [
		{ "source": "/editor", "destination": "/", "permanent": false },
		{ "source": "/export", "destination": "/", "permanent": false }
	],
	"rewrites": [
		{ "source": "/projects/:id", "destination": "/projects/[id]" },
		{ "source": "/projects/:id/export", "destination": "/projects/[id]/export" }
	]
}
